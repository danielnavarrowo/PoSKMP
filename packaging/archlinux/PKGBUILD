# Maintainer: daniel
pkgname=punto-de-venta
pkgver=1.2.14
pkgrel=1
pkgdesc="Punto de Venta - Sistema Punto de Venta (Compose Multiplatform)"
arch=('x86_64')
license=('custom')
depends=('glibc' 'hicolor-icon-theme')
provides=('poskmp')
options=('!strip')

build() {
    cd "$startdir/../.."
    if [ ! -d "desktopApp/build/compose/binaries/main-release/app/Punto de Venta" ]; then
        ./gradlew :desktopApp:createReleaseDistributable
    fi
}

package() {
    local app_dir="$startdir/../../desktopApp/build/compose/binaries/main-release/app/Punto de Venta"

    install -d "$pkgdir/opt/punto-de-venta"
    cp -a "$app_dir"/* "$pkgdir/opt/punto-de-venta/"

    # Backward compatibility symlink for /opt/poskmp
    ln -sf punto-de-venta "$pkgdir/opt/poskmp"

    # Launcher wrapper in /usr/bin
    install -d "$pkgdir/usr/bin"
    cat << 'EOF' > "$pkgdir/usr/bin/punto-de-venta"
#!/bin/sh
exec "/opt/punto-de-venta/bin/Punto de Venta" "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/punto-de-venta"
    ln -sf punto-de-venta "$pkgdir/usr/bin/poskmp"

    # Desktop entry
    install -Dm644 "$startdir/punto-de-venta.desktop" "$pkgdir/usr/share/applications/punto-de-venta.desktop"

    # Icons
    install -Dm644 "$startdir/../../desktopApp/src/main/resources/icons/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/punto-de-venta.png"
    install -Dm644 "$startdir/../../desktopApp/src/main/resources/icons/icon.png" \
        "$pkgdir/usr/share/pixmaps/punto-de-venta.png"
}
