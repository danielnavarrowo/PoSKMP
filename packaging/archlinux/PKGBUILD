# Maintainer: daniel
pkgname=poskmp
pkgver=1.2.17
pkgrel=1
pkgdesc="Punto de Venta - Sistema Punto de Venta (Compose Multiplatform)"
arch=('x86_64')
license=('custom')
depends=('glibc' 'hicolor-icon-theme')
options=('!strip')

build() {
    cd "$startdir/../.."
    if [ ! -d "desktopApp/build/compose/binaries/main-release/app/poskmp" ]; then
        ./gradlew :desktopApp:createReleaseDistributable
    fi
}

package() {
    local app_dir="$startdir/../../desktopApp/build/compose/binaries/main-release/app/poskmp"

    install -d "$pkgdir/opt/poskmp"
    cp -a "$app_dir"/* "$pkgdir/opt/poskmp/"

    # Launcher wrapper in /usr/bin
    install -d "$pkgdir/usr/bin"
    cat << 'EOF' > "$pkgdir/usr/bin/poskmp"
#!/bin/sh
exec "/opt/poskmp/bin/poskmp" "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/poskmp"
    ln -sf poskmp "$pkgdir/usr/bin/punto-de-venta"

    # Desktop entry - user sees "Punto de Venta" in desktop launcher and menu
    install -Dm644 "$startdir/poskmp.desktop" "$pkgdir/usr/share/applications/poskmp.desktop"

    # Icons
    install -Dm644 "$startdir/../../desktopApp/src/main/resources/icons/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/poskmp.png"
    install -Dm644 "$startdir/../../desktopApp/src/main/resources/icons/icon.png" \
        "$pkgdir/usr/share/pixmaps/poskmp.png"
}
