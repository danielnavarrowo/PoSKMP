
CREATE TABLE products (
    id             TEXT    PRIMARY KEY NOT NULL, -- UUID generated locally
    codigos        TEXT    NOT NULL DEFAULT '[]',
    nombre         TEXT    NOT NULL,
    precio         REAL    NOT NULL DEFAULT 0,
    costo          REAL    NOT NULL DEFAULT 0,
    categoria      TEXT    DEFAULT 'Sin categoria',
    activo         INTEGER NOT NULL DEFAULT 1, -- 0 = false, 1 = true
    por_peso       INTEGER NOT NULL DEFAULT 0, -- 0 = false, 1 = true
    precio_mayoreo REAL    NOT NULL DEFAULT 0,
    es_favorito    INTEGER NOT NULL DEFAULT 0, -- 0 = false, 1 = true
    piezas         REAL    NOT NULL DEFAULT 1.0,
    
    -- Sync fields
    updated_at     INTEGER NOT NULL, -- Unix epoch millisecond timestamp
    sync_state     TEXT    NOT NULL DEFAULT 'PENDING_INSERT' -- 'SYNCED', 'PENDING_INSERT', 'PENDING_UPDATE', 'PENDING_DELETE'
);

-- Queries

selectAllProducts:
SELECT * FROM products;

selectActiveProducts:
SELECT * FROM products WHERE activo = 1;

selectProductById:
SELECT * FROM products WHERE id = ?;

selectUnsyncedProducts:
SELECT * FROM products WHERE sync_state != 'SYNCED';

insertProduct:
INSERT OR REPLACE INTO products (
    id, codigos, nombre, precio, costo, 
    categoria, activo, por_peso, precio_mayoreo, es_favorito, piezas, 
    updated_at, sync_state
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateProduct:
UPDATE products
SET codigos = ?, nombre = ?, precio = ?, costo = ?, 
    categoria = ?, activo = ?, por_peso = ?, precio_mayoreo = ?, es_favorito = ?, piezas = ?, 
    updated_at = ?, sync_state = ?
WHERE id = ?;

deleteProductSoft:
UPDATE products
SET activo = 0, updated_at = ?, sync_state = 'PENDING_UPDATE'
WHERE id = ?;

deleteProductHard:
DELETE FROM products WHERE id = ?;

deleteAllProducts:
DELETE FROM products;

updateSyncStatus:
UPDATE products
SET sync_state = ?, updated_at = ?
WHERE id = ?;

updateProductSyncState:
UPDATE products
SET sync_state = ?
WHERE id = ?;

upsertSyncedProduct:
INSERT OR REPLACE INTO products (
    id, codigos, nombre, precio, costo, 
    categoria, activo, por_peso, precio_mayoreo, es_favorito, piezas, 
    updated_at, sync_state
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'SYNCED');

searchProducts:
SELECT * FROM products 
WHERE (nombre LIKE '%' || :query || '%' OR codigos LIKE '%' || :query || '%' OR codigos LIKE '%' || :normalizedQuery || '%' OR categoria LIKE '%' || :query || '%');

searchActiveProducts:
SELECT * FROM products 
WHERE activo = 1 AND (nombre LIKE '%' || :query || '%' OR codigos LIKE '%' || :query || '%' OR codigos LIKE '%' || :normalizedQuery || '%' OR categoria LIKE '%' || :query || '%');

-- ============================================
-- CUSTOMERS TABLES & QUERIES
-- ============================================

CREATE TABLE customers (
    id              TEXT    PRIMARY KEY NOT NULL,
    nombre          TEXT    NOT NULL,
    telefono        TEXT    NOT NULL DEFAULT '',
    direccion       TEXT    NOT NULL DEFAULT '',
    notas           TEXT    NOT NULL DEFAULT '',
    limite_credito  REAL    NOT NULL DEFAULT 0.0,
    siempre_mayoreo INTEGER NOT NULL DEFAULT 0,
    activo          INTEGER NOT NULL DEFAULT 1,
    created_at      INTEGER NOT NULL,
    updated_at      INTEGER NOT NULL,
    sync_state      TEXT    NOT NULL DEFAULT 'PENDING_INSERT'
);

CREATE INDEX idx_customers_nombre ON customers(nombre);
CREATE INDEX idx_customers_telefono ON customers(telefono);
CREATE INDEX idx_customers_activo ON customers(activo);
CREATE INDEX idx_customers_created_at ON customers(created_at);

CREATE TABLE customer_payments (
    id          TEXT    PRIMARY KEY NOT NULL,
    customer_id TEXT    NOT NULL,
    monto       REAL    NOT NULL,
    metodo_pago TEXT    NOT NULL DEFAULT 'EFECTIVO',
    notas       TEXT    NOT NULL DEFAULT '',
    created_at  INTEGER NOT NULL,
    sync_state  TEXT    NOT NULL DEFAULT 'PENDING_INSERT',
    FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE
);

CREATE INDEX idx_customer_payments_customer_id ON customer_payments(customer_id);
CREATE INDEX idx_customer_payments_created_at ON customer_payments(created_at);

-- Customer Queries

selectAllActiveCustomers:
SELECT c.*,
    COALESCE((SELECT SUM(
        CASE 
            WHEN s.metodo_pago = 'CREDITO' THEN s.total
            WHEN s.metodo_pago = 'MIXTO' AND s.total > s.pago_con THEN (s.total - s.pago_con)
            ELSE 0.0 
        END
    ) FROM sales s WHERE s.customer_id = c.id AND s.estado != 'CANCELADA'), 0.0) -
    COALESCE((SELECT SUM(cp.monto) FROM customer_payments cp WHERE cp.customer_id = c.id), 0.0) AS saldo_deudor,
    (SELECT COUNT(s.id) FROM sales s WHERE s.customer_id = c.id AND s.estado != 'CANCELADA') AS total_compras
FROM customers c
WHERE c.activo = 1
ORDER BY c.nombre ASC;

selectAllCustomers:
SELECT c.*,
    COALESCE((SELECT SUM(
        CASE 
            WHEN s.metodo_pago = 'CREDITO' THEN s.total
            WHEN s.metodo_pago = 'MIXTO' AND s.total > s.pago_con THEN (s.total - s.pago_con)
            ELSE 0.0 
        END
    ) FROM sales s WHERE s.customer_id = c.id AND s.estado != 'CANCELADA'), 0.0) -
    COALESCE((SELECT SUM(cp.monto) FROM customer_payments cp WHERE cp.customer_id = c.id), 0.0) AS saldo_deudor,
    (SELECT COUNT(s.id) FROM sales s WHERE s.customer_id = c.id AND s.estado != 'CANCELADA') AS total_compras
FROM customers c
ORDER BY c.nombre ASC;

selectCustomerById:
SELECT c.*,
    COALESCE((SELECT SUM(
        CASE 
            WHEN s.metodo_pago = 'CREDITO' THEN s.total
            WHEN s.metodo_pago = 'MIXTO' AND s.total > s.pago_con THEN (s.total - s.pago_con)
            ELSE 0.0 
        END
    ) FROM sales s WHERE s.customer_id = c.id AND s.estado != 'CANCELADA'), 0.0) -
    COALESCE((SELECT SUM(cp.monto) FROM customer_payments cp WHERE cp.customer_id = c.id), 0.0) AS saldo_deudor,
    (SELECT COUNT(s.id) FROM sales s WHERE s.customer_id = c.id AND s.estado != 'CANCELADA') AS total_compras
FROM customers c
WHERE c.id = ?;

searchActiveCustomers:
SELECT c.*,
    COALESCE((SELECT SUM(
        CASE 
            WHEN s.metodo_pago = 'CREDITO' THEN s.total
            WHEN s.metodo_pago = 'MIXTO' AND s.total > s.pago_con THEN (s.total - s.pago_con)
            ELSE 0.0 
        END
    ) FROM sales s WHERE s.customer_id = c.id AND s.estado != 'CANCELADA'), 0.0) -
    COALESCE((SELECT SUM(cp.monto) FROM customer_payments cp WHERE cp.customer_id = c.id), 0.0) AS saldo_deudor,
    (SELECT COUNT(s.id) FROM sales s WHERE s.customer_id = c.id AND s.estado != 'CANCELADA') AS total_compras
FROM customers c
WHERE c.activo = 1 AND (c.nombre LIKE '%' || :query || '%' OR c.telefono LIKE '%' || :query || '%' OR c.direccion LIKE '%' || :query || '%')
ORDER BY c.nombre ASC;

insertCustomer:
INSERT INTO customers (
    id, nombre, telefono, direccion, notas, limite_credito, siempre_mayoreo, activo, created_at, updated_at, sync_state
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCustomer:
UPDATE customers
SET nombre = ?, telefono = ?, direccion = ?, notas = ?, limite_credito = ?, siempre_mayoreo = ?, updated_at = ?, sync_state = ?
WHERE id = ?;

setCustomerActiveStatus:
UPDATE customers
SET activo = ?, updated_at = ?, sync_state = ?
WHERE id = ?;

deleteCustomerHard:
DELETE FROM customers WHERE id = ?;

selectUnsyncedCustomers:
SELECT * FROM customers WHERE sync_state != 'SYNCED';

updateCustomerSyncState:
UPDATE customers SET sync_state = ? WHERE id = ?;

upsertSyncedCustomer:
INSERT OR REPLACE INTO customers (
    id, nombre, telefono, direccion, notas, limite_credito, siempre_mayoreo, activo, created_at, updated_at, sync_state
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'SYNCED');

-- Customer Payments Queries

insertCustomerPayment:
INSERT INTO customer_payments (
    id, customer_id, monto, metodo_pago, notas, created_at, sync_state
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectPaymentsByCustomerId:
SELECT * FROM customer_payments
WHERE customer_id = ?
ORDER BY created_at DESC;

deleteCustomerPayment:
DELETE FROM customer_payments WHERE id = ?;

selectUnsyncedCustomerPayments:
SELECT * FROM customer_payments WHERE sync_state != 'SYNCED';

updateCustomerPaymentSyncState:
UPDATE customer_payments SET sync_state = ? WHERE id = ?;

upsertSyncedCustomerPayment:
INSERT OR REPLACE INTO customer_payments (
    id, customer_id, monto, metodo_pago, notas, created_at, sync_state
) VALUES (?, ?, ?, ?, ?, ?, 'SYNCED');

selectCustomerDebtSummary:
SELECT 
    COUNT(c.id) AS total_clientes,
    COALESCE(SUM(CASE WHEN deuda.saldo > 0 THEN deuda.saldo ELSE 0.0 END), 0.0) AS total_deuda_acumulada,
    COUNT(CASE WHEN deuda.saldo > 0 THEN 1 END) AS clientes_con_deuda
FROM customers c
LEFT JOIN (
    SELECT c2.id,
        COALESCE((SELECT SUM(
            CASE 
                WHEN s.metodo_pago = 'CREDITO' THEN s.total
                WHEN s.metodo_pago = 'MIXTO' AND s.total > s.pago_con THEN (s.total - s.pago_con)
                ELSE 0.0 
            END
        ) FROM sales s WHERE s.customer_id = c2.id AND s.estado != 'CANCELADA'), 0.0) -
        COALESCE((SELECT SUM(cp.monto) FROM customer_payments cp WHERE cp.customer_id = c2.id), 0.0) AS saldo
    FROM customers c2
) deuda ON c.id = deuda.id
WHERE c.activo = 1;

-- ============================================
-- SALES & ANALYTICS TABLES & QUERIES
-- ============================================

CREATE TABLE sales (
    id             TEXT    PRIMARY KEY NOT NULL,
    folio          INTEGER NOT NULL,
    total          REAL    NOT NULL,
    total_original REAL    NOT NULL,
    total_costo    REAL    NOT NULL,
    ganancia       REAL    NOT NULL,
    pago_con       REAL    NOT NULL,
    cambio         REAL    NOT NULL,
    metodo_pago    TEXT    NOT NULL DEFAULT 'EFECTIVO',
    total_items    REAL    NOT NULL DEFAULT 0,
    customer_id    TEXT    DEFAULT NULL,
    created_at     INTEGER NOT NULL,
    sync_state     TEXT    NOT NULL DEFAULT 'PENDING_INSERT',
    shift_id       TEXT    DEFAULT NULL,
    cashier_id     TEXT    DEFAULT NULL,
    cashier_name   TEXT    DEFAULT NULL,
    estado         TEXT    NOT NULL DEFAULT 'COMPLETADA',
    FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE SET NULL
);

CREATE INDEX idx_sales_created_at ON sales(created_at);
CREATE INDEX idx_sales_customer_id ON sales(customer_id);
CREATE INDEX idx_sales_shift_id ON sales(shift_id);
CREATE INDEX idx_sales_estado ON sales(estado);

CREATE TABLE sale_items (
    id              TEXT    PRIMARY KEY NOT NULL,
    sale_id         TEXT    NOT NULL,
    product_id      TEXT,
    product_nombre  TEXT    NOT NULL,
    cantidad        REAL    NOT NULL,
    precio_unitario REAL    NOT NULL,
    costo_unitario  REAL    NOT NULL,
    subtotal        REAL    NOT NULL,
    ganancia        REAL    NOT NULL,
    es_mayoreo      INTEGER NOT NULL DEFAULT 0,
    created_at      INTEGER NOT NULL,
    FOREIGN KEY (sale_id) REFERENCES sales(id) ON DELETE CASCADE
);

CREATE INDEX idx_sale_items_sale_id ON sale_items(sale_id);
CREATE INDEX idx_sale_items_product_id ON sale_items(product_id);
CREATE INDEX idx_sale_items_created_at ON sale_items(created_at);

-- Sales Queries

insertSale:
INSERT INTO sales (
    id, folio, total, total_original, total_costo, ganancia,
    pago_con, cambio, metodo_pago, total_items, customer_id, created_at, sync_state,
    shift_id, cashier_id, cashier_name, estado
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectUnsyncedSales:
SELECT * FROM sales WHERE sync_state != 'SYNCED';

updateSaleSyncState:
UPDATE sales SET sync_state = ? WHERE id = ?;

upsertSyncedSale:
INSERT OR REPLACE INTO sales (
    id, folio, total, total_original, total_costo, ganancia,
    pago_con, cambio, metodo_pago, total_items, customer_id, created_at, sync_state,
    shift_id, cashier_id, cashier_name, estado
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'SYNCED', ?, ?, ?, ?);

cancelSale:
UPDATE sales
SET estado = 'CANCELADA', sync_state = 'PENDING_UPDATE'
WHERE id = ?;

selectSalesByCustomerId:
SELECT * FROM sales
WHERE customer_id = ?
ORDER BY created_at DESC;

selectCreditSalesByCustomerId:
SELECT * FROM sales
WHERE customer_id = ? AND estado != 'CANCELADA' AND (metodo_pago = 'CREDITO' OR (metodo_pago = 'MIXTO' AND total > pago_con))
ORDER BY created_at DESC;

insertSaleItem:
INSERT INTO sale_items (
    id, sale_id, product_id, product_nombre, cantidad,
    precio_unitario, costo_unitario, subtotal, ganancia, es_mayoreo, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertSyncedSaleItem:
INSERT OR REPLACE INTO sale_items (
    id, sale_id, product_id, product_nombre, cantidad,
    precio_unitario, costo_unitario, subtotal, ganancia, es_mayoreo, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getNextFolio:
SELECT COALESCE(MAX(folio), 0) + 1 AS next_folio FROM sales;

selectSalesSummaryBetween:
SELECT 
    COALESCE(SUM(total), 0.0) AS total_ventas,
    COALESCE(SUM(total_original), 0.0) AS total_sin_descuento,
    COALESCE(SUM(total_costo), 0.0) AS total_costo,
    COALESCE(SUM(ganancia), 0.0) AS total_ganancia,
    CASE 
        WHEN SUM(total_costo) > 0 THEN ((SUM(ganancia) / SUM(total_costo)) * 100.0)
        ELSE 0.0 
    END AS porcentaje_ganancia,
    COUNT(id) AS total_ticket_count,
    COALESCE(AVG(total), 0.0) AS promedio_ticket
FROM sales 
WHERE estado != 'CANCELADA' AND (
    (:shiftId IS NULL AND created_at >= :startTime AND created_at <= :endTime)
    OR (:shiftId IS NOT NULL AND shift_id = :shiftId)
);

selectTopSellingProductsBetween:
SELECT 
    si.product_id,
    si.product_nombre,
    SUM(si.cantidad) AS total_unidades,
    SUM(si.subtotal) AS total_recaudado,
    SUM(si.ganancia) AS ganancia_generada
FROM sale_items si
INNER JOIN sales s ON si.sale_id = s.id
WHERE s.estado != 'CANCELADA' AND (
    (:shiftId IS NULL AND s.created_at >= :startTime AND s.created_at <= :endTime)
    OR (:shiftId IS NOT NULL AND s.shift_id = :shiftId)
)
GROUP BY si.product_id, si.product_nombre
ORDER BY total_unidades DESC
LIMIT :limit;

selectLeastSellingProductsBetween:
SELECT 
    si.product_id,
    si.product_nombre,
    SUM(si.cantidad) AS total_unidades,
    SUM(si.subtotal) AS total_recaudado,
    SUM(si.ganancia) AS ganancia_generada
FROM sale_items si
INNER JOIN sales s ON si.sale_id = s.id
WHERE s.estado != 'CANCELADA' AND (
    (:shiftId IS NULL AND s.created_at >= :startTime AND s.created_at <= :endTime)
    OR (:shiftId IS NOT NULL AND s.shift_id = :shiftId)
)
GROUP BY si.product_id, si.product_nombre
ORDER BY total_unidades ASC
LIMIT :limit;

selectRecentSales:
SELECT * FROM sales 
ORDER BY created_at DESC 
LIMIT :limit OFFSET :offset;

selectSalesBetween:
SELECT * FROM sales 
WHERE (:shiftId IS NULL AND created_at >= :startTime AND created_at <= :endTime)
   OR (:shiftId IS NOT NULL AND shift_id = :shiftId)
ORDER BY created_at DESC 
LIMIT :limit OFFSET :offset;

selectPaymentMethodSalesBetween:
SELECT 
    metodo_pago,
    COALESCE(SUM(total), 0.0) AS total_recaudado,
    COUNT(id) AS total_transacciones
FROM sales
WHERE estado != 'CANCELADA' AND (
    (:shiftId IS NULL AND created_at >= :startTime AND created_at <= :endTime)
    OR (:shiftId IS NOT NULL AND shift_id = :shiftId)
)
GROUP BY metodo_pago
ORDER BY total_recaudado DESC;

selectCategorySalesBetween:
SELECT 
    COALESCE(p.categoria, 'Sin categoría') AS categoria,
    COALESCE(SUM(si.subtotal), 0.0) AS total_recaudado,
    COALESCE(SUM(si.cantidad), 0.0) AS total_unidades
FROM sale_items si
INNER JOIN sales s ON si.sale_id = s.id
LEFT JOIN products p ON si.product_id = p.id
WHERE s.estado != 'CANCELADA' AND (
    (:shiftId IS NULL AND s.created_at >= :startTime AND s.created_at <= :endTime)
    OR (:shiftId IS NOT NULL AND s.shift_id = :shiftId)
)
GROUP BY COALESCE(p.categoria, 'Sin categoría')
ORDER BY total_recaudado DESC;

selectDailySalesBetween:
SELECT 
    strftime('%Y-%m-%d', created_at / 1000, 'unixepoch', 'localtime') AS dia,
    COALESCE(SUM(total), 0.0) AS total_recaudado,
    COALESCE(SUM(ganancia), 0.0) AS total_ganancia,
    COUNT(id) AS total_transacciones
FROM sales
WHERE estado != 'CANCELADA' AND (
    (:shiftId IS NULL AND created_at >= :startTime AND created_at <= :endTime)
    OR (:shiftId IS NOT NULL AND shift_id = :shiftId)
)
GROUP BY dia
ORDER BY dia ASC;

selectSaleById:
SELECT * FROM sales WHERE id = ?;

selectItemsBySaleId:
SELECT * FROM sale_items WHERE sale_id = ?;

selectAllSalesCount:
SELECT COUNT(id) FROM sales WHERE estado != 'CANCELADA';

selectAllProductSalesStats:
SELECT 
    si.product_id,
    COALESCE(SUM(si.cantidad), 0.0) AS total_unidades_vendidas,
    MAX(s.created_at) AS ultima_venta
FROM sale_items si
INNER JOIN sales s ON si.sale_id = s.id
WHERE s.estado != 'CANCELADA' AND si.product_id IS NOT NULL
GROUP BY si.product_id;

-- ============================================
-- TOMBSTONES / DELETED SYNC RECORDS
-- ============================================

CREATE TABLE deleted_sync_records (
    id          TEXT    PRIMARY KEY NOT NULL,
    entity_type TEXT    NOT NULL,
    deleted_at  INTEGER NOT NULL
);

insertDeletedSyncRecord:
INSERT OR REPLACE INTO deleted_sync_records (id, entity_type, deleted_at)
VALUES (?, ?, ?);

selectDeletedSyncRecords:
SELECT * FROM deleted_sync_records;

deleteDeletedSyncRecord:
DELETE FROM deleted_sync_records WHERE id = ?;

-- ============================================
-- CASHIERS, SHIFTS & CASH MOVEMENTS TABLES & QUERIES
-- ============================================

CREATE TABLE cashiers (
    id         TEXT    PRIMARY KEY NOT NULL,
    nombre     TEXT    NOT NULL,
    pin        TEXT    NOT NULL DEFAULT '0000',
    activo     INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    sync_state TEXT    NOT NULL DEFAULT 'PENDING_INSERT'
);

CREATE INDEX idx_cashiers_activo ON cashiers(activo);

CREATE TABLE shifts (
    id                   TEXT    PRIMARY KEY NOT NULL,
    cashier_id           TEXT    NOT NULL,
    cashier_name         TEXT    NOT NULL,
    start_time           INTEGER NOT NULL,
    end_time             INTEGER DEFAULT NULL,
    initial_cash         REAL    NOT NULL DEFAULT 0.0,
    final_cash_expected  REAL    DEFAULT NULL,
    final_cash_counted   REAL    DEFAULT NULL,
    difference           REAL    DEFAULT NULL,
    notes                TEXT    DEFAULT NULL,
    is_closed            INTEGER NOT NULL DEFAULT 0,
    sync_state           TEXT    NOT NULL DEFAULT 'PENDING_INSERT',
    FOREIGN KEY (cashier_id) REFERENCES cashiers(id) ON DELETE RESTRICT
);

CREATE INDEX idx_shifts_is_closed ON shifts(is_closed);
CREATE INDEX idx_shifts_start_time ON shifts(start_time);

CREATE TABLE cash_movements (
    id          TEXT    PRIMARY KEY NOT NULL,
    shift_id    TEXT    NOT NULL,
    cashier_id  TEXT    NOT NULL,
    tipo        TEXT    NOT NULL, -- 'ENTRADA', 'SALIDA'
    monto       REAL    NOT NULL,
    motivo      TEXT    NOT NULL,
    created_at  INTEGER NOT NULL,
    sync_state  TEXT    NOT NULL DEFAULT 'PENDING_INSERT',
    FOREIGN KEY (shift_id) REFERENCES shifts(id) ON DELETE CASCADE,
    FOREIGN KEY (cashier_id) REFERENCES cashiers(id) ON DELETE RESTRICT
);

CREATE INDEX idx_cash_movements_shift_id ON cash_movements(shift_id);

-- Cashier Queries
selectAllActiveCashiers:
SELECT * FROM cashiers WHERE activo = 1 ORDER BY nombre ASC;

selectAllCashiers:
SELECT * FROM cashiers ORDER BY nombre ASC;

selectCashierById:
SELECT * FROM cashiers WHERE id = ?;

countCashiers:
SELECT COUNT(id) FROM cashiers;

countActiveCashiers:
SELECT COUNT(id) FROM cashiers WHERE activo = 1;

insertCashier:
INSERT OR REPLACE INTO cashiers (
    id, nombre, pin, activo, created_at, updated_at, sync_state
) VALUES (?, ?, ?, ?, ?, ?, ?);

updateCashier:
UPDATE cashiers
SET nombre = ?, pin = ?, activo = ?, updated_at = ?, sync_state = ?
WHERE id = ?;

deactivateCashier:
UPDATE cashiers
SET activo = 0, updated_at = ?, sync_state = 'PENDING_UPDATE'
WHERE id = ?;

-- Shift Queries
selectActiveShift:
SELECT * FROM shifts WHERE is_closed = 0 ORDER BY start_time DESC LIMIT 1;

selectShiftById:
SELECT * FROM shifts WHERE id = ?;

selectAllShifts:
SELECT * FROM shifts ORDER BY start_time DESC;

selectShiftsBetween:
SELECT * FROM shifts 
WHERE (start_time BETWEEN :startTime AND :endTime) 
   OR (start_time <= :endTime AND (end_time >= :startTime OR is_closed = 0))
ORDER BY start_time DESC;

insertShift:
INSERT INTO shifts (
    id, cashier_id, cashier_name, start_time, end_time,
    initial_cash, final_cash_expected, final_cash_counted, difference, notes, is_closed, sync_state
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

closeShift:
UPDATE shifts
SET end_time = ?, final_cash_expected = ?, final_cash_counted = ?, difference = ?, notes = ?, is_closed = 1, sync_state = 'PENDING_UPDATE'
WHERE id = ?;

-- Cash Movements Queries
selectMovementsByShiftId:
SELECT * FROM cash_movements WHERE shift_id = ? ORDER BY created_at ASC;

insertCashMovement:
INSERT INTO cash_movements (
    id, shift_id, cashier_id, tipo, monto, motivo, created_at, sync_state
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

sumMovementsByShiftAndType:
SELECT COALESCE(SUM(monto), 0.0) AS total FROM cash_movements WHERE shift_id = ? AND tipo = ?;

-- Shift Sales Summary Queries
selectSalesSummaryByShift:
SELECT 
    COALESCE(SUM(total), 0.0) AS total_ventas,
    COALESCE(SUM(
        CASE 
            WHEN metodo_pago = 'EFECTIVO' THEN total
            WHEN metodo_pago = 'MIXTO' THEN (pago_con - cambio)
            ELSE 0.0 
        END
    ), 0.0) AS ventas_efectivo,
    COALESCE(SUM(CASE WHEN metodo_pago = 'TARJETA' THEN total ELSE 0.0 END), 0.0) AS ventas_tarjeta,
    COALESCE(SUM(CASE WHEN metodo_pago = 'TRANSFERENCIA' THEN total ELSE 0.0 END), 0.0) AS ventas_transferencia,
    COALESCE(SUM(CASE WHEN metodo_pago = 'CREDITO' THEN total ELSE 0.0 END), 0.0) AS ventas_credito,
    COALESCE(SUM(CASE WHEN metodo_pago = 'MIXTO' THEN total ELSE 0.0 END), 0.0) AS ventas_mixto,
    COUNT(id) AS total_transacciones
FROM sales
WHERE estado != 'CANCELADA' AND (shift_id = :shiftId OR (created_at >= :startTime AND (:endTime IS NULL OR created_at <= :endTime)));

selectCancelledSalesSummaryByShift:
SELECT 
    COALESCE(SUM(total), 0.0) AS total_cancelado,
    COUNT(id) AS total_tickets_cancelados
FROM sales
WHERE estado = 'CANCELADA' AND (shift_id = :shiftId OR (created_at >= :startTime AND (:endTime IS NULL OR created_at <= :endTime)));

selectCancelledSalesByShift:
SELECT * FROM sales
WHERE estado = 'CANCELADA' AND (shift_id = :shiftId OR (created_at >= :startTime AND (:endTime IS NULL OR created_at <= :endTime)))
ORDER BY created_at DESC;
